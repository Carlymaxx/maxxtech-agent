# Copy this to .env and fill in the values

# Database (auto-set when using docker-compose)
DATABASE_URL=postgresql://maxxtech:YOUR_DB_PASSWORD@db:5432/maxxtech
POSTGRES_PASSWORD=change_this_to_a_strong_password

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change_this_to_a_random_secret

# Anthropic AI via Replit AI Integrations
# Get these from your Replit project environment variables
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=your_anthropic_api_key_here
